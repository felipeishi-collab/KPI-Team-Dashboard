PORT=3001
GOOGLE_CLIENT_ID=

# Google Sheets (planilha principal - ATs no piso)
GOOGLE_SHEETS_CREDENTIALS_PATH=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Google Sheets - planilha de drivers/rejeites (gráfico de barras do BAU)
# Se deixar em branco, usa a mesma GOOGLE_SHEETS_SPREADSHEET_ID acima.
GOOGLE_SHEETS_DRIVERS_SPREADSHEET_ID=

# Google Sheets - planilha de SPR (Roteirizado x Delivering, gráfico do BAU)
# Se deixar em branco, usa a mesma GOOGLE_SHEETS_SPREADSHEET_ID acima.
GOOGLE_SHEETS_SPR_SPREADSHEET_ID=

# Segredo para assinar os tokens de sessão. Opcional: se vazio, é gerado
# uma vez e salvo em backend/.cache/session_secret.txt.
SESSION_SECRET=

# Google Sheets - planilha do Barômetro (aba Report). Sem fallback: é outra planilha.
# Compartilhe com o e-mail da service account (Leitor).
GOOGLE_SHEETS_BAROMETRO_SPREADSHEET_ID=
